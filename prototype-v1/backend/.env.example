# .env.example — copy to .env and fill in real values before running
# Do NOT commit .env to version control.

# --- InLegalBERT model weights directory (HuggingFace save_pretrained format) ---
MODEL_PATH=./models/LegalModelShared

# --- Supabase ---
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# --- Active Learning confidence thresholds ---
CONFIDENCE_HIGH=0.85
CONFIDENCE_LOW=0.55

# --- Worker batch size for prediction jobs ---
BATCH_SIZE=8
