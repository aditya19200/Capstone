// medical_ontology_seed.cypher
//
// GENERATED by graph/mine_concept_markers.py --domain medical
// Source of truth: domains/medical.json
//
// The domain nodes. Load this before the concept seed, or let the
// concept seed MERGE them itself — either order works.
//
//   Node label   : OntologyNode { label, description }
//   Relationship : (:OntologyNode)-[:RELATED_TO]->(:OntologyNode)

CREATE CONSTRAINT ontology_node_label IF NOT EXISTS
FOR (n:OntologyNode) REQUIRE n.label IS UNIQUE;

MERGE (n:OntologyNode {label: "Cardiovascular / Pulmonary"}) SET n.description = "Heart, vasculature and lungs: catheterisation, echocardiography, respiratory failure.";
MERGE (n:OntologyNode {label: "Orthopedic"}) SET n.description = "Bones, joints, ligaments and the musculoskeletal system, including arthroplasty and fracture repair.";
MERGE (n:OntologyNode {label: "Radiology"}) SET n.description = "Imaging studies and their interpretation: MRI, CT, ultrasound, plain films.";
MERGE (n:OntologyNode {label: "Gastroenterology"}) SET n.description = "Digestive tract, liver, biliary system and pancreas, including endoscopy and colonoscopy.";
MERGE (n:OntologyNode {label: "Neurology"}) SET n.description = "Disorders of the brain, spinal cord, nerves and muscles, managed without surgery.";
MERGE (n:OntologyNode {label: "Urology"}) SET n.description = "Urinary tract and the male reproductive system: stones, prostate, bladder.";
MERGE (n:OntologyNode {label: "Obstetrics / Gynecology"}) SET n.description = "Pregnancy, childbirth and the female reproductive system.";
MERGE (n:OntologyNode {label: "ENT - Otolaryngology"}) SET n.description = "Ear, nose, throat, head and neck: tonsillectomy, sinus surgery, hearing loss.";
MERGE (n:OntologyNode {label: "Neurosurgery"}) SET n.description = "Operative treatment of the brain, spine and peripheral nerves.";
MERGE (n:OntologyNode {label: "Hematology - Oncology"}) SET n.description = "Blood disorders and cancer: chemotherapy, staging, haematological malignancy.";
MERGE (n:OntologyNode {label: "Ophthalmology"}) SET n.description = "The eye and visual system: cataract extraction, retinal disease, glaucoma.";
MERGE (n:OntologyNode {label: "Nephrology"}) SET n.description = "Kidney function and disease, including dialysis and renal failure.";

MATCH (a:OntologyNode {label: "Cardiovascular / Pulmonary"}), (b:OntologyNode {label: "Nephrology"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Cardiovascular / Pulmonary"}), (b:OntologyNode {label: "Radiology"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Orthopedic"}), (b:OntologyNode {label: "Radiology"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Orthopedic"}), (b:OntologyNode {label: "Neurosurgery"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Radiology"}), (b:OntologyNode {label: "Orthopedic"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Radiology"}), (b:OntologyNode {label: "Neurology"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Radiology"}), (b:OntologyNode {label: "Cardiovascular / Pulmonary"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Gastroenterology"}), (b:OntologyNode {label: "Hematology - Oncology"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Neurology"}), (b:OntologyNode {label: "Neurosurgery"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Neurology"}), (b:OntologyNode {label: "Radiology"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Urology"}), (b:OntologyNode {label: "Nephrology"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Obstetrics / Gynecology"}), (b:OntologyNode {label: "Urology"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "ENT - Otolaryngology"}), (b:OntologyNode {label: "Ophthalmology"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Neurosurgery"}), (b:OntologyNode {label: "Neurology"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Neurosurgery"}), (b:OntologyNode {label: "Orthopedic"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Hematology - Oncology"}), (b:OntologyNode {label: "Gastroenterology"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Ophthalmology"}), (b:OntologyNode {label: "ENT - Otolaryngology"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Nephrology"}), (b:OntologyNode {label: "Urology"}) MERGE (a)-[:RELATED_TO]->(b);
MATCH (a:OntologyNode {label: "Nephrology"}), (b:OntologyNode {label: "Cardiovascular / Pulmonary"}) MERGE (a)-[:RELATED_TO]->(b);
