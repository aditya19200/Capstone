# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments (backend/venv alone is ~5 GB)
venv/
.venv/
env/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
dist/
.vite/

# ---------------------------------------------------------------------------
# Secrets — .env holds the Supabase service_role key. Never commit it.
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local

# ---------------------------------------------------------------------------
# Model weights — far over GitHub's 100 MB per-file limit.
# These are distributed out of band (shared drive), not through git.
# NOTE: backend/models/ also holds request_models.py / response_models.py,
# which ARE tracked — so the ignores below are deliberately specific.
# ---------------------------------------------------------------------------
# Any checkpoint directory under backend/models/. Named by pattern rather
# than one by one: the per-name list below used to be the whole rule, so
# adding a second domain quietly staged a 414 MB model.safetensors that
# GitHub would have rejected on push. The .py files in that folder are
# tracked; the weight directories are not.
prototype-v1/backend/models/*/
# ...and the symlink. A pattern ending in "/" matches directories only, and
# LegalModelShared is a symlink to a checkout elsewhere on this machine, so
# the rule above does not catch it — git sees a file. Committing it would
# put an absolute path from one laptop into the repository, which resolves
# to nothing on anyone else's.
prototype-v1/backend/models/LegalModelShared
!prototype-v1/backend/models/*.py
*.safetensors

# Raw corpora as downloaded. Re-fetchable in one command, and the curated
# split derived from them (datasets/medical_v1.csv) is what the training
# actually reads.
prototype-v1/datasets/medical-raw/

# Per-retrain metrics are generated output, but baseline_metrics.json is a
# measured result the API reads at startup to register the deployed model —
# without it every checkout opens with an empty admin table, so it ships.
prototype-v1/backend/metrics/*
!prototype-v1/backend/metrics/baseline_metrics.json

# Local model dumps and scratch copies sitting in the working folder
LegalModel/
FinalWindows/
ILC/
archive/
archive.zip

# ---------------------------------------------------------------------------
# Logs and runtime output
# ---------------------------------------------------------------------------
*.log
backend.log
prediction_worker.log
xai_worker.log
batch_worker.log

# ---------------------------------------------------------------------------
# Submission artifacts and recordings — reports, decks, screen captures.
# These live on Drive, not in git: the demo recording alone is 8 MB, none of
# them can be diffed, and git keeps every version of a binary forever.
# Root level only, so documents kept under docs/ can still be committed.
# ---------------------------------------------------------------------------
/*.docx
/*.pdf
/*.pptx
/*.webm

# Downloaded reference corpora — not part of the repo. The curated demo
# subset lives in sample-data/demo/pdfs/ instead.
prototype-v1/pdfs/
